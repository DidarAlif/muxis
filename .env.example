# MUXIS Production & Development Environment Configuration
# Copy this file to .env and fill in your project credentials.

# -----------------------------------------------------------------------------
# Supabase Configuration (Client Credentials - Public with RLS Protection)
# -----------------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# -----------------------------------------------------------------------------
# Optional Custom Cloudflare Services (Leave blank to use default public endpoints)
# -----------------------------------------------------------------------------
CLOUDFLARE_WORKER_URL=https://api.muxis.audio
CLOUDFLARE_R2_PUBLIC_URL=https://cdn.muxis.audio

# -----------------------------------------------------------------------------
# Deep Linking & Auth Redirect (e.g., for OAuth callback)
# -----------------------------------------------------------------------------
AUTH_REDIRECT_SCHEME=muxis
AUTH_REDIRECT_HOST=auth-callback
