{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "muxis-api-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-21",
  "workers_dev": true,
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "muxis-cloud-db",
      "database_id": "00bd4f18-5ebf-4310-b36c-6530b2d736d6"
    }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "LATEST_VERSION": "1.2.12",
    "MIN_SUPPORTED_VERSION": "1.0.0",
    "FIREBASE_PROJECT_ID": "muxis-cloud",
    "FIREBASE_WEB_API_KEY": "AIzaSyD2LtscFC3xX8TlC1jdpOk7DoPLSbTxFcg",
    "FIREBASE_AUTH_BRIDGE_URL": "https://muxis-cloud.firebaseapp.com"
  }
}
