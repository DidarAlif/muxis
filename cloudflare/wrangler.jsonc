{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "muxis-api-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-21",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "r2_buckets": [
    {
      "binding": "MUXIS_STORAGE",
      "bucket_name": "muxis-storage",
      "preview_bucket_name": "muxis-storage-preview"
    }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "LATEST_VERSION": "1.0.0",
    "MIN_SUPPORTED_VERSION": "1.0.0"
  }
}
